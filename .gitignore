# secrets
.env

# data (DVC-tracked — commit .dvc files, not the data itself)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# generated dashboards (regenerate with scripts/build_dashboard.py; too large to commit per build)
monitoring/handicapper*.html
# generated daily slates + nightly logs (scripts/daily_slate.py, nightly.sh)
monitoring/slate*.html
monitoring/nightly-logs/
# live results log (ESPN-sourced via scripts/fetch_results.py; regenerable — dvc add if you want to version it)
data/live/

# python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/

# ml artifacts
mlruns/
mlruns.db
*.pkl
*.joblib

# notebooks
.ipynb_checkpoints/

# docs
docs/*.pdf
# internal planning doc — kept local, not published (mirrors kitchen-platform)
docs/backlog.md

# generated Terraform (produced on demand by `recipes apply`, never committed)
infra/tf/

# claude
CLAUDE.md
AGENTS.md
.claude

# generated Kaggle submissions (scripts/competition_submission.py)
data/submissions/
