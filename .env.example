KENPOM_API_KEY=your_bearer_token_here
AWS_PROFILE=default

# mlplatform/tracking — set both for S3-backed experiment tracking
# Omit MLFLOW_TRACKING_URI to use local file store (./mlruns) during development
MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
MLFLOW_ARTIFACT_BUCKET=your-s3-bucket-name

# Optional overrides
MLFLOW_EXPERIMENT=cbb-tournament
